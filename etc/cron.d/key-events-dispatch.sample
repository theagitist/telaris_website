# Pluriverse key-events push dispatcher (federation stage 4h).
#
# Reads key_event_push_attempts rows where delivery_status IN ('pending',
# 'failed') AND next_attempt_at <= NOW(), wraps each row's signed JWS in
# a coord-signed HTTP request (tag = tel-key-events), and POSTs to
# <peer>/api/pluriverse/key-events-push. Self-bounded to 50 rows per
# invocation; running every minute is safe even if the queue grows.
#
# Idempotent. Honours v10's exponential backoff (1m / 5m / 30m / 2h / 6h /
# 12h / 24h then give-up at attempt 7). The JWS itself is unchanged
# across the hop; only the transport-layer signature differs per peer.
#
# Installed by bin/setup-host.php; canonical source is
# etc/cron.d/key-events-dispatch.sample. Substitutes __SITE_ROOT__ at
# install time.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Every minute: drain a batch from the push queue.
* * * * * www-data /usr/bin/php __SITE_ROOT__/bin/key-events-dispatch > /dev/null 2>&1
