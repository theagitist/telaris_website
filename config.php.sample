<?php
declare(strict_types=1);

// Pluriverse website — runtime configuration template.
//
// Copy this file to config.php and fill in the values for your instance.
// config.php is gitignored and lives per-host. Suggested perms after
// editing: 0640 root:www-data (set by bin/setup-host.php).

define('DB_HOST', 'your-database-hostname');
define('DB_PORT', '5432');
define('DB_NAME', 'pluriverse');
define('DB_USER', 'pluriverse');
define('DB_PASS', 'your-database-password');
// Optional: path to a CA certificate for a TLS Postgres connection. When set
// and non-empty, the DSN appends sslmode=verify-ca + sslrootcert=<path>.
// Leave undefined (or '') for a local/non-TLS connection.
// define('DB_SSL_CA', '/etc/ssl/your-db-ca.crt');

// Path to the Telaris documentation repo on this host. The Manifest /
// Privacy / Terms pages render their markdown live from this tree.
// PHP-FPM (www-data) needs read access; bin/setup-host.php can apply
// the necessary filesystem ACLs.
define('PLURIVERSE_DOCS_SRC', '/home/<your-user>/apps/telaris/documentation/src');

// Mailgun SMTP credentials. Used for magic-link delivery, application
// acknowledgements, and admin-action notices. The Pluriverse reuses the
// same Mailgun account / sending domain (telaris.ca) the Telaris instances
// use; copy these five constants from any Telaris instance's config.php.
define('MAIL_SMTP_HOST', 'smtp.mailgun.org');
define('MAIL_SMTP_PORT', 25);
define('MAIL_SMTP_USER', '<your mailgun smtp user>');
define('MAIL_SMTP_PASS', '<your mailgun smtp password>');
define('MAIL_SMTP_SECURE', 'tls');
define('MAIL_FROM_ADDRESS', 'no-reply@telaris.ca');
define('MAIL_FROM_NAME', 'Pluriverse');

require_once __DIR__ . '/inc/db.php';
